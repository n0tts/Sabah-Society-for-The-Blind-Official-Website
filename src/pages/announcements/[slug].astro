---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const entries = (await getCollection('announcements')).filter((a) => !a.data.draft);
	return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const formatDate = (date: Date) =>
	new Intl.DateTimeFormat('en-MY', { year: 'numeric', month: 'long', day: '2-digit' }).format(date);
---

<BaseLayout title={`${entry.data.title} | Announcements | Sabah Society for the Blind`} description={entry.data.description}>
	<Header />

	<main>
		<section class="bg-primary text-white py-14 md:py-16">
			<div class="container mx-auto px-4">
				<div class="max-w-4xl">
					<p class="text-sm uppercase tracking-widest text-slate-200 mb-3">Announcement</p>
					<h1 class="text-3xl md:text-5xl font-heading font-bold mb-4">{entry.data.title}</h1>
					<p class="text-slate-200 italic">{formatDate(entry.data.pubDate)}</p>
				</div>
			</div>
		</section>

		<section class="py-16 md:py-20 bg-white">
			<div class="container mx-auto px-4">
				<div class="max-w-4xl">
					<a class="inline-flex items-center gap-2 font-heading uppercase text-primary hover:text-accent transition-colors mb-10" href="/announcements">
						<span aria-hidden="true">←</span>
						Back to announcements
					</a>

					<article
						class="max-w-none text-slate-800 leading-relaxed
						[&_p]:my-4
						[&_hr]:my-8 [&_hr]:border-slate-200
						[&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:text-2xl [&_h2]:text-primary [&_h2]:font-heading [&_h2]:uppercase
						[&_h3]:mt-6 [&_h3]:mb-2 [&_h3]:text-xl [&_h3]:text-primary [&_h3]:font-heading [&_h3]:uppercase
						[&_ul]:my-4 [&_ul]:list-disc [&_ul]:pl-6
						[&_ol]:my-4 [&_ol]:list-decimal [&_ol]:pl-6
						[&_li]:my-1
						[&_a]:text-primary hover:[&_a]:text-accent
						[&_table]:my-6 [&_table]:w-full [&_table]:border-collapse
						[&_th]:border [&_th]:border-slate-200 [&_th]:bg-slate-50 [&_th]:p-3 [&_th]:text-left
						[&_td]:border [&_td]:border-slate-200 [&_td]:p-3"
					>
						<Content />
					</article>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</BaseLayout>
