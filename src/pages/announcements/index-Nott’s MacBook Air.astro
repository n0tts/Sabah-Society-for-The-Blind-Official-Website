---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const announcements = (await getCollection('announcements'))
	.filter((a) => !a.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatDate = (date: Date) =>
	new Intl.DateTimeFormat('en-MY', { year: 'numeric', month: 'long', day: '2-digit' }).format(date);
---

<BaseLayout title="Announcements | Sabah Society for the Blind" description="Official announcements and public notices from Sabah Society for the Blind.">
	<Header />

	<main>
		<section class="bg-primary text-white py-20">
			<div class="container mx-auto px-4">
				<div class="max-w-3xl">
					<h1 class="text-4xl md:text-5xl font-heading font-bold mb-6">Announcements</h1>
					<p class="text-xl text-slate-200 leading-relaxed">
						Public notices, tenders, and official updates from Sabah Society for the Blind.
					</p>
				</div>
			</div>
		</section>

		<section class="py-20 bg-white">
			<div class="container mx-auto px-4">
				{announcements.length === 0 ? (
					<p class="text-lg text-slate-700 leading-relaxed max-w-3xl">
						No announcements have been published yet.
					</p>
				) : (
					<ul class="space-y-6 max-w-4xl">
						{announcements.map((entry) => (
							<li class="border border-slate-200 rounded-2xl p-6 md:p-8 shadow-sm hover:shadow-md transition-shadow">
								<div class="flex flex-col md:flex-row md:items-start md:justify-between gap-2">
									<h2 class="text-2xl font-heading text-primary uppercase">
										<a class="hover:text-accent transition-colors" href={`/announcements/${entry.slug}`}>
											{entry.data.title}
										</a>
									</h2>
									<p class="text-sm text-slate-500 italic whitespace-nowrap">
										{formatDate(entry.data.pubDate)}
									</p>
								</div>
								{entry.data.description ? (
									<p class="text-slate-700 mt-3 leading-relaxed">{entry.data.description}</p>
								) : null}
								<div class="mt-5">
									<a class="inline-flex items-center gap-2 font-heading uppercase text-primary hover:text-accent transition-colors" href={`/announcements/${entry.slug}`}>
										Read announcement
										<span aria-hidden="true">→</span>
									</a>
								</div>
							</li>
						))}
					</ul>
				)}
			</div>
		</section>
	</main>

	<Footer />
</BaseLayout>

